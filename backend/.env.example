PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=nvocc
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Auth / RBAC / Team / Audit
JWT_SECRET=<random 64-char string>
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=nvocc_token
COOKIE_SECURE=false
PASSWORD_RESET_EXPIRES_MINUTES=60
INVITATION_EXPIRES_DAYS=7

# SMTP — leave SMTP_HOST empty in dev to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NVOCC Ops <no-reply@nvocc.local>"

# Bootstrap admin — seeded once via `npm run seed`, idempotent
ADMIN_EMAIL=admin@nvocc.local
ADMIN_DEFAULT_PASSWORD=<temp password, change after first login>
